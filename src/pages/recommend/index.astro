---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Directory from '../../components/Directory.astro';
import FAQ from '../../components/FAQ.astro';
import { services, limited, sourceBadge } from '../../data/services';

const title = '机场推荐与套餐对比：价格、线路与协议资料整理｜ivpn';
const description =
  'ivpn 整理无忧链接、微风网络、飞猫云、Firefly、光速云等机场的价格、线路、协议、节点地区与客户端资料，逐项标注官方、第三方或仅确认入口的来源，购买前先看清口径。';

const detailed = services.filter((s) => s.sourceLevel !== 'entry');
const airportArticles = await getCollection('airport');
const pick = (slugs: string[]) =>
  slugs.map((s) => airportArticles.find((e) => e.id === s)).filter((e): e is NonNullable<typeof e> => !!e);
const guides = pick(['how-to-choose-airport', 'beginner-choose-airport', 'monthly-vs-yearly-airport', 'first-purchase-checklist', 'cost-effective-airport', 'airport-test-metrics']);

const faq = [
  {
    q: '这个列表的顺序是按质量排名吗？',
    a: '不是。列表默认按编辑顺序排列，本站对其中的入口使用推荐链接，并重点介绍排在第一位的无忧链接。本站没有对这些服务做过统一条件下的测速，所以不提供评分或质量排名。',
  },
  {
    q: '页面上的价格为什么口径不一样？',
    a: '有的服务只公开月付价格，有的资料给出的是年付折算的月均价。本站在每个价格旁边写明口径，比较时请只在口径相同的条件下比较，实际价格以结算页为准。',
  },
  {
    q: '“资料有限”的服务能买吗？',
    a: '本站只确认了这几家的官方入口可以访问，没有创建账户，所以无法给出套餐、价格、节点等结论。想了解可以直接到官网查看，并先买最短周期。',
  },
  {
    q: '为什么有些服务没有详情页？',
    a: '详情页只为有足够资料的服务建立，避免写出空洞的页面。资料补充后会增加。',
  },
];
---
<BaseLayout {title} {description} headerNote="套餐、参数与限制">
  <section class="page-head">
    <div class="wrap">
      <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '机场推荐' }]} />
      <h1>机场推荐与套餐对比</h1>
      <p class="summary">
        把价格、线路、协议、节点地区和客户端放在同一张表里比较，并逐项标注资料来源：官方页面、第三方整理，还是只确认了官方入口。没有资料的地方直接写“暂无”，不用估算或评分填空。
      </p>
    </div>
  </section>

  <div class="wrap section">
    <div class="access-note">
      <span aria-hidden="true">i</span>
      <span>点击“前往官网”后打不开，通常是官网地址被墙或当前网络受限。已有代理请先开启；也可以先阅读<a href="/airport/wuyou/">无忧链接的介绍</a>，再选择合适的入口。</span>
    </div>
    <div class="disclosure-note">
      <p><strong>推荐关系说明：</strong>列表默认顺序由本站编辑决定，列表中的“前往官网”入口使用推荐链接（rel=sponsored），可能为本站带来返佣，不会增加你的购买价格。这不是质量排名，本站没有做统一条件下的测速。资料整理于 2026-09-21，分级规则见<a href="/about/">关于 ivpn</a>。</p>
    </div>

    <Directory items={services} idPrefix="rec" />
  </div>

  <div class="wrap section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">横向对比</span>
        <h2>资料里能比较的几项</h2>
        <p>只列出资料中明确出现的内容；价格口径不同，请看“计费口径”一列。</p>
      </div>
    </div>
    <div class="table-wrap">
      <table class="plain cmp">
        <thead><tr><th>服务</th><th>起步价格</th><th>计费口径</th><th>线路</th><th>协议</th><th>节点地区</th><th>资料来源</th></tr></thead>
        <tbody>
          {detailed.map((s) => (
            <tr>
              <th scope="row">{s.page ? <a href={s.page}>{s.name}</a> : s.name}</th>
              <td>{s.priceText}</td>
              <td>{s.priceBasis}</td>
              <td>{s.line}</td>
              <td>{s.protocols}</td>
              <td>{s.nodes}</td>
              <td>{sourceBadge[s.sourceLevel]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="color:var(--muted);font-size:.88rem">
      资料有限、暂未列入对比的服务：{limited.map((s) => s.name).join('、')}。它们的公开资料不足，本站只确认了官方入口可访问。
    </p>
  </div>

  <div class="wrap section">
    <div class="section-heading">
      <div><span class="eyebrow">怎么用这张表</span><h2>先看口径，再比价格</h2></div>
    </div>
    <div class="copy-cols">
      <div>
        <h3>价格要在同一口径下比较</h3>
        <p>月付价格和年付折算的月均价不能直接比：年付需要一次性预付更长周期，试错成本更高。本站在每个价格旁边标出口径，第一次购买时，优先选择可以按月试用的方案。</p>
        <p>流量额度也要一起看：同样的月均价，含 40GB 和含 100GB 的每 GB 成本相差很大，具体算法见<a href="/airport/cost-effective-airport/">性价比机场怎么看</a>。</p>
      </div>
      <div>
        <h3>资料来源决定了可信程度</h3>
        <p>“官方/联盟页面资料”来自服务方自己的页面，“第三方资料整理”来自公开转述，“仅确认入口”意味着连价格都没有核实。线路是否真的稳定、协议是否真如宣传，只有自己实际使用才知道。</p>
        <p>建议按<a href="/airport/first-purchase-checklist/">购买前核对清单</a>先买最短周期，测几天再决定。</p>
      </div>
    </div>
  </div>

  <div class="wrap section">
    <div class="section-heading">
      <div><span class="eyebrow">购买前先读</span><h2>选购指南</h2></div>
      <a class="text-link" href="/airport/">查看全部 →</a>
    </div>
    <div class="card-grid">
      {guides.map((g) => (
        <a class="card" href={`/airport/${g.id}/`}>
          <span class="icon">↗</span>
          <h3>{g.data.title}</h3>
          <p>{g.data.summary}</p>
        </a>
      ))}
    </div>
  </div>

  <div class="wrap section">
    <FAQ items={faq} />
  </div>
</BaseLayout>

<style>
  .cmp { min-width: 900px; }
</style>
