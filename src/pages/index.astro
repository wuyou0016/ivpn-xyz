---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Directory from '../components/Directory.astro';
import FAQ from '../components/FAQ.astro';
import { services, withPage, limited, byId } from '../data/services';

const vpn = await getCollection('vpn');
const airport = await getCollection('airport');
const guide = await getCollection('guide');
const articleCount = vpn.length + airport.length + guide.length;

const title = 'ivpn｜机场推荐、套餐对比与 VPN 知识';
const description =
  'ivpn 整理机场推荐、套餐价格、线路协议与客户端资料，并用中文讲清 VPN、机场、代理与节点的基础知识；重点介绍无忧链接，资料来源逐项标注。';

const featured = ['wuyou', 'weifeng', 'feimao'].map((id) => byId(id));
const homeList = services.slice(0, 7);

const lane = async (col: 'vpn' | 'airport' | 'guide', slugs: string[]) =>
  (await Promise.all(slugs.map((s) => getEntry(col, s)))).filter((e): e is NonNullable<typeof e> => !!e).map((e) => ({
    href: `/${col}/${e.id}/`,
    title: e.data.title,
  }));
const lanes = [
  { name: 'VPN 知识', desc: '先弄懂 VPN、代理与节点这些词。', all: '/vpn/', items: await lane('vpn', ['what-is-vpn', 'vpn-vs-proxy', 'is-vpn-safe']) },
  { name: '机场知识', desc: '机场是什么、怎么选、为什么会限速。', all: '/airport/', items: await lane('airport', ['what-is-airport', 'how-to-choose-airport', 'why-airport-slow-at-night']) },
  { name: '客户端教程', desc: '拿到订阅链接之后，怎么导入使用。', all: '/guide/', items: await lane('guide', ['windows-proxy-setup', 'iphone-proxy-setup', 'clash-basics']) },
];

const faq = [
  {
    q: '看机场套餐时，先看哪几项？',
    a: '先看计费周期和实际流量额度，再看节点倍率、同时在线设备数、常用地区是否有节点，以及客户端和退款规则。节点总数和宣传带宽不能单独说明体验好坏。',
  },
  {
    q: '第一次购买，月付和年付怎么选？',
    a: '没有使用经验时，优先能按月试用的方案，先确认线路和客户端能用，再考虑年付。年付折算的月均价更低，但要一次性承担更长的预付周期，详见《机场月付还是年付怎么选》。',
  },
  {
    q: '本站的价格资料可靠吗？',
    a: '本站把资料分成三类：官方或联盟页面的展示信息、第三方公开资料整理、仅确认入口可访问，并在每条资料旁标出来源。没有资料的地方会写“暂无”，本站也没有做统一条件下的测速，不提供评分。',
  },
  {
    q: '通过本站的链接购买会更贵吗？',
    a: '不会。本站的“前往官网”入口是推荐链接（rel=sponsored），通过它注册可能为本站带来返佣，但不会增加你的购买价格，也不影响本站如实写出的缺点与限制。',
  },
];
---
<BaseLayout {title} {description}>
  <section class="intro">
    <div class="wrap intro-grid">
      <div>
        <span class="eyebrow">ivpn · 2026年9月资料整理</span>
        <h1>机场推荐、套餐对比与 VPN 知识</h1>
        <p class="lead">
          把机场的价格、流量、线路、协议和客户端资料放在一起比较，每条资料都标明来源；同时用简单的中文讲清 VPN、机场、代理与节点的基础概念。没有数据的地方，我们直接写“暂无”。
        </p>
        <div class="intro-actions">
          <a class="cta-card" href="/recommend/"><span class="cta-mark">VS</span><span><strong>机场套餐对比</strong><small>价格 · 线路 · 协议 · 节点</small></span></a>
          <a class="cta-card alt" href="/guide/"><span class="cta-mark">HOW</span><span><strong>配置教程</strong><small>Windows · macOS · iPhone · Android</small></span></a>
        </div>
      </div>
      <div class="stat-grid" aria-label="站内资料统计">
        <div class="stat"><strong>{services.length}</strong><span>收录服务</span></div>
        <div class="stat"><strong>{withPage.length}</strong><span>详情资料页</span></div>
        <div class="stat"><strong>{articleCount}</strong><span>知识文章</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <div><span class="eyebrow">编辑精选</span><h2>先从这三家看起</h2><p>按本站编辑顺序列出，含推荐链接；这不是质量排名。</p></div>
        <a class="text-link" href="/recommend/">查看全部套餐对比 →</a>
      </div>
      <div class="featured-grid">
        {featured.map((s) => (
          <article class:list={['feat', { top: s.id === 'wuyou' }]}>
            <div class="feat-head">
              <span class="logo-tile" style={`--h:${s.hue}`} aria-hidden="true">{s.mark}</span>
              <div>
                <h3><a href={s.page} style="color:inherit;text-decoration:none">{s.name}</a></h3>
                {s.id === 'wuyou' && <span class="chip gold">本站重点介绍</span>}
              </div>
            </div>
            <p>{s.tagline}</p>
            <div class="feat-price">{s.priceText} <small>· {s.priceBasis}</small></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <a class="button ghost" style="padding:.5em 1em;font-size:.88rem" href={s.page}>查看资料</a>
              <a class:list={['button', { gold: s.id === 'wuyou' }]} style="padding:.5em 1em;font-size:.88rem" href={s.aff} target="_blank" rel="nofollow noopener sponsored" data-svc={s.id}>前往官网 ↗</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <div><span class="eyebrow">机场目录</span><h2>套餐与线路资料</h2></div>
        <a class="text-link" href="/recommend/">完整目录（含横向对比表）→</a>
      </div>
      <div class="access-note">
        <span aria-hidden="true">i</span>
        <span>点击“前往官网”后打不开，通常是官网地址被墙或当前网络受限。已有代理请先开启，再访问需要打开的官网。</span>
      </div>
      <Directory items={homeList} idPrefix="home" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <div><span class="eyebrow">静态资料入口</span><h2>全部机场详情页</h2></div>
      </div>
      <nav class="directory-links" aria-label="全部机场详情页">
        {withPage.map((s) => (
          <a href={s.page}><strong>{s.name}</strong><span>{s.priceText} · 查看套餐与线路</span></a>
        ))}
      </nav>
      <p style="margin-top:12px;color:var(--muted);font-size:.86rem">资料有限、暂无详情页：{limited.map((s) => s.name).join('、')}（仅确认官方入口可访问）。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <div><span class="eyebrow">选购参考</span><h2>机场怎么选</h2></div>
        <a class="text-link" href="/airport/">阅读选购与机场知识 →</a>
      </div>
      <div class="copy-cols">
        <div>
          <h3>先定计费周期，再比套餐</h3>
          <p>第一次选机场，不建议只看宣传价格和总流量。能按月试用的方案适合先验证常用地区、客户端和本地网络；年付折算的月均价更低，但要承担更长的预付风险；不限时流量包适合用得不多、只想备用的人。</p>
          <p>选之前先估算每月流量和同时在线设备数，再核对常用节点地区和线路类型。同一个服务，在不同地区、运营商和时段体验可能相差很大。</p>
        </div>
        <div>
          <h3>本站怎么整理资料</h3>
          <p>本站把价格、流量、线路、协议、节点地区、客户端、退款和支付方式逐项整理，并标明每项来自官方页面、第三方资料，还是只确认了入口。资料缺失的地方就写缺失，不用评分或估算补上。</p>
          <p>服务方的宣传参数、库存和活动价格会变化，购买前请以官网下单页为准，并优先选择最短周期。资料分级和推荐关系的完整说明见<a href="/about/">关于 ivpn</a>。</p>
        </div>
      </div>
      <div class="choice-grid" aria-label="按场景选择">
        <a href="/airport/cost-effective-airport/"><span>预算有限</span><strong>性价比机场怎么看</strong><p>单位流量价格、倍率与预付周期。</p></a>
        <a href="/airport/beginner-choose-airport/"><span>首次购买</span><strong>新手怎么选择机场</strong><p>先验证，再决定是否长期使用。</p></a>
        <a href="/airport/monthly-vs-yearly-airport/"><span>计费周期</span><strong>月付还是年付</strong><p>预付风险与折算价的取舍。</p></a>
        <a href="/airport/airport-for-ai-tools/"><span>AI 工具</span><strong>用机场访问 AI 工具</strong><p>先核对节点地区与服务条款。</p></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <div><span class="eyebrow">知识库</span><h2>先弄懂，再选择</h2></div>
      </div>
      <div class="lane-grid">
        {lanes.map((l) => (
          <div class="lane">
            <h3>{l.name}</h3>
            <p>{l.desc}</p>
            <ul>{l.items.map((i) => <li><a href={i.href}>{i.title}</a></li>)}</ul>
            <a class="text-link" href={l.all}>查看全部 →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap"><FAQ items={faq} /></div>
  </section>

  <div class="wrap">
    <p class="affiliate-note">部分外部入口为推荐链接（rel=sponsored），可能为本站带来返佣，不影响你的购买价格与本站的内容判断。</p>
  </div>
</BaseLayout>
