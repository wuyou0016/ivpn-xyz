---
interface Item {
  q: string;
  a: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props as Props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---
<section class="faq">
  <h2>常见问题</h2>
  <div class="faq-list">
    {items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
